# Required Telegram bot token. Never commit the real value.
MODERATION_BOT_TOKEN=

# Comma-separated Telegram usernames allowed to use the admin bot.
MODERATION_ALLOWED_USERNAMES=
MODERATION_ADMIN_USERNAMES=

# Local SQLite database; the database directory is ignored by Git.
MODERATION_DATABASE_URL=sqlite+aiosqlite:///data/moderation.sqlite3
